# YouTube Data API v3 key (console.cloud.google.com) — required for YouTube ingest
YOUTUBE_API_KEY=

# Anthropic API key — required (the only LLM provider)
ANTHROPIC_API_KEY=

# Optional platform tokens (connectors fall back to manual exports without them)
INSTAGRAM_ACCESS_TOKEN=
X_BEARER_TOKEN=
TIKTOK_ACCESS_TOKEN=

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-4-6
# DATA_DIR=/data           (persistent disk mount on hosted backends)
# APP_ENV=production
# CORS_ORIGINS=https://your-frontend.example
